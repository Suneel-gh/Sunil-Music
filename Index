<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Swara - Telugu & Tamil Music Hub</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Custom Scrollbar & Mobile Optimizations */
    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-thumb { background: #374151; border-radius: 4px; }
    body { -webkit-tap-highlight-color: transparent; }
    .active-tab { color: #38bdf8; border-bottom: 2px solid #38bdf8; }
  </style>
</head>
<body class="bg-slate-950 text-slate-100 flex flex-col h-screen overflow-hidden select-none font-sans">

  <!-- Top App Bar -->
  <header class="bg-slate-900 border-b border-slate-800 px-4 py-3 flex items-center justify-between shrink-0 shadow-md">
    <div class="flex items-center space-x-2">
      <i class="fa-solid fa-compact-disc text-sky-400 text-xl animate-spin" style="animation-duration: 8s;"></i>
      <h1 class="text-lg font-bold tracking-wide bg-gradient-to-r from-sky-400 to-indigo-400 bg-clip-text text-transparent">Swara Music</h1>
    </div>
    <div class="flex items-center space-x-3">
      <button onclick="triggerAutoSync()" title="Sync New Songs" class="p-2 text-slate-400 hover:text-sky-400 transition">
        <i class="fa-solid fa-arrows-rotate" id="syncIcon"></i>
      </button>
      <button onclick="openPlaylistModal()" title="Playlists" class="p-2 text-slate-400 hover:text-sky-400 transition">
        <i class="fa-solid fa-list-ul"></i>
      </button>
    </div>
  </header>

  <!-- Search & Filter Controls -->
  <section class="p-3 bg-slate-900/60 border-b border-slate-800/80 shrink-0 space-y-2">
    <!-- Search Bar with Local vs Online Toggle -->
    <div class="flex items-center space-x-2">
      <div class="relative flex-1">
        <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-500 text-sm"></i>
        <input type="text" id="searchInput" placeholder="Search Telugu, Tamil songs..."
               class="w-full bg-slate-800/90 text-sm pl-9 pr-3 py-2 rounded-lg border border-slate-700/80 focus:border-sky-500 focus:outline-none transition placeholder-slate-500">
      </div>
      <!-- Mode Toggle -->
      <button id="searchModeBtn" onclick="toggleSearchMode()" class="px-3 py-2 bg-slate-800 border border-slate-700 text-xs font-semibold rounded-lg text-sky-400 flex items-center space-x-1 shrink-0">
        <i class="fa-solid fa-hard-drive text-xs"></i>
        <span id="searchModeLabel">Local</span>
      </button>
    </div>

    <!-- Category Filters -->
    <div class="flex items-center space-x-2 overflow-x-auto text-xs py-1 no-scrollbar">
      <button onclick="filterCategory('ALL')" class="cat-pill bg-sky-500/20 text-sky-400 border border-sky-500/40 px-3 py-1 rounded-full font-medium shrink-0">All</button>
      <button onclick="filterCategory('TELUGU')" class="cat-pill bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full font-medium shrink-0">Telugu</button>
      <button onclick="filterCategory('TAMIL')" class="cat-pill bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full font-medium shrink-0">Tamil</button>
      <button onclick="filterCategory('CLASSICAL')" class="cat-pill bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full font-medium shrink-0">Carnatic / Classic</button>
      <button onclick="filterCategory('DEVOTIONAL')" class="cat-pill bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full font-medium shrink-0">Devotional</button>
    </div>
  </section>

  <!-- Track List Container (Scrollable Area) -->
  <main class="flex-1 overflow-y-auto p-3 space-y-2 pb-28" id="trackList">
    <div class="text-center text-slate-500 py-16 text-sm">Loading songs...</div>
  </main>

  <!-- Persistent Player Bar -->
  <footer class="fixed bottom-0 inset-x-0 bg-slate-900 border-t border-slate-800 px-4 py-2 flex flex-col justify-between shrink-0 shadow-2xl z-20">
    <!-- Progress Bar & Timers -->
    <div class="w-full flex items-center space-x-2 text-[10px] text-slate-400 mb-1">
      <span id="currentTime">0:00</span>
      <input type="range" id="seekSlider" value="0" min="0" step="1" class="flex-1 h-1 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-sky-400">
      <span id="duration">0:00</span>
    </div>

    <!-- Controls & Track Info -->
    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-3 overflow-hidden max-w-[55%]">
        <div class="w-10 h-10 bg-slate-800 rounded-md flex items-center justify-center shrink-0 border border-slate-700 text-sky-400">
          <i class="fa-solid fa-music"></i>
        </div>
        <div class="truncate">
          <p id="playerTrackTitle" class="text-xs font-semibold text-slate-100 truncate">No Track Selected</p>
          <p id="playerTrackArtist" class="text-[10px] text-slate-400 truncate">Select a track to play</p>
        </div>
      </div>

      <!-- Playback Buttons -->
      <div class="flex items-center space-x-3">
        <button onclick="prevTrack()" class="text-slate-400 hover:text-slate-100 text-sm">
          <i class="fa-solid fa-backward-step"></i>
        </button>
        <button onclick="togglePlay()" id="playPauseBtn" class="w-9 h-9 rounded-full bg-sky-500 hover:bg-sky-400 text-slate-950 flex items-center justify-center shadow-lg transition">
          <i class="fa-solid fa-play ml-0.5 text-sm" id="playIcon"></i>
        </button>
        <button onclick="nextTrack()" class="text-slate-400 hover:text-slate-100 text-sm">
          <i class="fa-solid fa-forward-step"></i>
        </button>
      </div>
    </div>
  </footer>

  <!-- Hidden HTML5 Audio Element -->
  <audio id="audioEngine" preload="metadata"></audio>

  <!-- Playlist Modal -->
  <div id="playlistModal" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-30 flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-800 w-full max-w-sm rounded-xl p-4 shadow-2xl flex flex-col max-h-[80vh]">
      <div class="flex items-center justify-between pb-3 border-b border-slate-800">
        <h2 class="text-sm font-bold text-slate-100">My Playlists</h2>
        <button onclick="closePlaylistModal()" class="text-slate-400 hover:text-slate-100"><i class="fa-solid fa-xmark"></i></button>
      </div>
      <div class="my-3 flex space-x-2">
        <input type="text" id="newPlaylistName" placeholder="New Playlist name" class="bg-slate-800 text-xs px-3 py-2 rounded-lg border border-slate-700 flex-1 focus:outline-none">
        <button onclick="createPlaylist()" class="bg-sky-500 text-slate-950 text-xs font-bold px-3 py-2 rounded-lg">Add</button>
      </div>
      <div id="playlistContainer" class="flex-1 overflow-y-auto space-y-2 py-2 text-xs"></div>
    </div>
  </div>

  <!-- JavaScript Application Logic -->
  <script>
    // --- 1. IndexedDB Wrapper for Local Audio Storage ---
    const DB_NAME = 'SwaraMusicDB';
    const DB_VERSION = 1;
    let db;

    function initDB() {
      return new Promise((resolve, reject) => {
        const req = indexedDB.open(DB_NAME, DB_VERSION);
        req.onupgradeneeded = (e) => {
          const dbInstance = e.target.result;
          if (!dbInstance.objectStoreNames.contains('tracks')) {
            const trackStore = dbInstance.createObjectStore('tracks', { keyPath: 'id' });
            trackStore.createIndex('language', 'language', { unique: false });
            trackStore.createIndex('title', 'title', { unique: false });
          }
          if (!dbInstance.objectStoreNames.contains('playlists')) {
            dbInstance.createObjectStore('playlists', { keyPath: 'id', autoIncrement: true });
          }
        };
        req.onsuccess = () => { db = req.result; resolve(); };
        req.onerror = () => reject('IndexedDB Init Error');
      });
    }

    function saveTrackToDB(track) {
      return new Promise((resolve, reject) => {
        const tx = db.transaction('tracks', 'readwrite');
        tx.objectStore('tracks').put(track);
        tx.oncomplete = () => resolve();
        tx.onerror = () => reject();
      });
    }

    function getAllTracksFromDB() {
      return new Promise((resolve) => {
        const tx = db.transaction('tracks', 'readonly');
        const req = tx.objectStore('tracks').getAll();
        req.onsuccess = () => resolve(req.result || []);
        req.onerror = () => resolve([]);
      });
    }

    // --- 2. State & Seed Data ---
    let localTracks = [];
    let currentPlaylist = [];
    let currentIndex = -1;
    let isPlaying = false;
    let searchMode = 'LOCAL'; // 'LOCAL' or 'ONLINE'
    let selectedCategory = 'ALL';

    // Curated high-quality, public-domain & Creative Commons baseline tracks
    const DEFAULT_CATALOGUE = [
      {
        id: 'archive_tel_01',
        title: 'Endaro Mahanubhavulu (Sri Raga)',
        artist: 'Thyagaraja Swamy',
        language: 'TELUGU',
        genre: 'CLASSICAL',
        streamUrl: 'https://archive.org/download/EndaroMahanubhavulu_Carnatic/Endaro.mp3',
        isDownloaded: false
      },
      {
        id: 'archive_tam_01',
        title: 'Kurai Ondrum Illai',
        artist: 'C. Rajagopalachari / Classic',
        language: 'TAMIL',
        genre: 'DEVOTIONAL',
        streamUrl: 'https://archive.org/download/KuraiOndrumIlla/KuraiOndrum.mp3',
        isDownloaded: false
      },
      {
        id: 'archive_tel_02',
        title: 'Vatapi Ganapatim',
        artist: 'Muthuswami Dikshitar',
        language: 'TELUGU',
        genre: 'CLASSICAL',
        streamUrl: 'https://archive.org/download/VatapiGanapatimBhaje/Vatapi.mp3',
        isDownloaded: false
      },
      {
        id: 'archive_tam_02',
        title: 'Brahmam Okate (Annamacharya)',
        artist: 'Traditional Folk Ensemble',
        language: 'TELUGU',
        genre: 'DEVOTIONAL',
        streamUrl: 'https://archive.org/download/BrahmamOkate_Traditional/BrahmamOkate.mp3',
        isDownloaded: false
      }
    ];

    const audio = document.getElementById('audioEngine');

    // --- 3. App Initialization ---
    window.addEventListener('DOMContentLoaded', async () => {
      await initDB();
      localTracks = await getAllTracksFromDB();
      
      // Seed default songs if database is fresh
      if (localTracks.length === 0) {
        for (const item of DEFAULT_CATALOGUE) {
          await saveTrackToDB(item);
        }
        localTracks = await getAllTracksFromDB();
      }

      currentPlaylist = [...localTracks];
      renderTrackList(currentPlaylist);
      setupAudioListeners();
      setupSearchListener();
    });

    // --- 4. Render Tracks ---
    function renderTrackList(tracks) {
      const container = document.getElementById('trackList');
      if (tracks.length === 0) {
        container.innerHTML = `
          <div class="text-center text-slate-500 py-16">
            <i class="fa-solid fa-music text-3xl mb-2 text-slate-600"></i>
            <p class="text-xs">No tracks found.</p>
          </div>`;
        return;
      }

      container.innerHTML = tracks.map((t, idx) => `
        <div class="bg-slate-900 border border-slate-800/80 hover:border-slate-700 rounded-xl p-3 flex items-center justify-between transition group">
          <div class="flex items-center space-x-3 flex-1 overflow-hidden cursor-pointer" onclick="playTrackById('${t.id}')">
            <div class="w-10 h-10 rounded-lg bg-slate-800 flex items-center justify-center text-xs font-bold text-sky-400 shrink-0">
              ${t.language === 'TAMIL' ? 'TA' : 'TE'}
            </div>
            <div class="truncate">
              <h4 class="text-xs font-semibold text-slate-200 truncate group-hover:text-sky-400">${t.title}</h4>
              <p class="text-[10px] text-slate-400 truncate">${t.artist} • <span class="text-sky-400/80">${t.language}</span></p>
            </div>
          </div>
          <div class="flex items-center space-x-2 pl-2">
            ${t.isDownloaded ? 
              `<span class="text-emerald-400 text-xs px-2" title="Saved on Device"><i class="fa-solid fa-circle-check"></i></span>` :
              `<button onclick="downloadTrack('${t.id}')" class="p-2 text-slate-400 hover:text-sky-400 text-xs" title="Save Offline">
                <i class="fa-solid fa-arrow-down-to-line" id="dl-${t.id}"></i>
              </button>`
            }
          </div>
        </div>
      `).join('');
    }

    // --- 5. Audio Player Controllers ---
    function playTrackById(id) {
      const index = currentPlaylist.findIndex(t => t.id === id);
      if (index === -1) return;
      currentIndex = index;
      const track = currentPlaylist[currentIndex];

      // Play from local Blob if downloaded, otherwise direct stream
      audio.src = track.localBlob ? URL.createObjectURL(track.localBlob) : track.streamUrl;
      audio.play();
      isPlaying = true;

      document.getElementById('playerTrackTitle').innerText = track.title;
      document.getElementById('playerTrackArtist').innerText = `${track.artist} (${track.language})`;
      updatePlayIcon();
      setupMediaSession(track);
    }

    function togglePlay() {
      if (currentIndex === -1 && currentPlaylist.length > 0) {
        playTrackById(currentPlaylist[0].id);
        return;
      }
      if (audio.paused) {
        audio.play();
        isPlaying = true;
      } else {
        audio.pause();
        isPlaying = false;
      }
      updatePlayIcon();
    }

    function nextTrack() {
      if (currentPlaylist.length === 0) return;
      currentIndex = (currentIndex + 1) % currentPlaylist.length;
      playTrackById(currentPlaylist[currentIndex].id);
    }

    function prevTrack() {
      if (currentPlaylist.length === 0) return;
      currentIndex = (currentIndex - 1 + currentPlaylist.length) % currentPlaylist.length;
      playTrackById(currentPlaylist[currentIndex].id);
    }

    function updatePlayIcon() {
      const icon = document.getElementById('playIcon');
      if (isPlaying) {
        icon.classList.remove('fa-play', 'ml-0.5');
        icon.classList.add('fa-pause');
      } else {
        icon.classList.remove('fa-pause');
        icon.classList.add('fa-play', 'ml-0.5');
      }
    }

    function setupAudioListeners() {
      const seekSlider = document.getElementById('seekSlider');
      const curTimeTxt = document.getElementById('currentTime');
      const durTimeTxt = document.getElementById('duration');

      audio.addEventListener('timeupdate', () => {
        if (!isNaN(audio.duration)) {
          seekSlider.max = Math.floor(audio.duration);
          seekSlider.value = Math.floor(audio.currentTime);
          curTimeTxt.innerText = formatTime(audio.currentTime);
          durTimeTxt.innerText = formatTime(audio.duration);
        }
      });

      seekSlider.addEventListener('input', () => {
        audio.currentTime = seekSlider.value;
      });

      audio.addEventListener('ended', nextTrack);
    }

    function formatTime(secs) {
      const m = Math.floor(secs / 60) || 0;
      const s = Math.floor(secs % 60) || 0;
      return `${m}:${s < 10 ? '0' : ''}${s}`;
    }

    // Android Lock-Screen Media Controls
    function setupMediaSession(track) {
      if ('mediaSession' in navigator) {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: track.title,
          artist: track.artist,
          album: `${track.language} Collection`
        });
        navigator.mediaSession.setActionHandler('play', togglePlay);
        navigator.mediaSession.setActionHandler('pause', togglePlay);
        navigator.mediaSession.setActionHandler('nexttrack', nextTrack);
        navigator.mediaSession.setActionHandler('previoustrack', prevTrack);
      }
    }

    // --- 6. Offline Storage Engine ---
    async function downloadTrack(trackId) {
      const icon = document.getElementById(`dl-${trackId}`);
      if (icon) icon.className = 'fa-solid fa-spinner animate-spin text-sky-400';

      const track = localTracks.find(t => t.id === trackId);
      if (!track) return;

      try {
        const resp = await fetch(track.streamUrl);
        const blob = await resp.blob();
        track.localBlob = blob;
        track.isDownloaded = true;
        await saveTrackToDB(track);
        renderTrackList(currentPlaylist);
      } catch (err) {
        alert('Could not download audio stream for offline caching.');
        if (icon) icon.className = 'fa-solid fa-arrow-down-to-line';
      }
    }

    // --- 7. Search & Online Fetching ---
    function setupSearchListener() {
      const input = document.getElementById('searchInput');
      input.addEventListener('input', () => executeSearch(input.value));
    }

    function toggleSearchMode() {
      searchMode = searchMode === 'LOCAL' ? 'ONLINE' : 'LOCAL';
      document.getElementById('searchModeLabel').innerText = searchMode;
      const btn = document.getElementById('searchModeBtn');
      if (searchMode === 'ONLINE') {
        btn.classList.add('bg-sky-500/20', 'border-sky-500');
      } else {
        btn.classList.remove('bg-sky-500/20', 'border-sky-500');
      }
      executeSearch(document.getElementById('searchInput').value);
    }

    async function executeSearch(query) {
      query = query.trim().toLowerCase();
      if (searchMode === 'LOCAL') {
        let results = localTracks.filter(t => {
          const matchQuery = t.title.toLowerCase().includes(query) || t.artist.toLowerCase().includes(query);
          const matchCat = (selectedCategory === 'ALL') || (t.language === selectedCategory || t.genre === selectedCategory);
          return matchQuery && matchCat;
        });
        currentPlaylist = results;
        renderTrackList(currentPlaylist);
      } else {
        if (!query) return;
        // Search public audio records on Archive.org API
        const container = document.getElementById('trackList');
        container.innerHTML = `<div class="text-center text-slate-400 py-16 text-xs"><i class="fa-solid fa-spinner animate-spin mr-1"></i> Searching open online archives...</div>`;
        try {
          const res = await fetch(`https://archive.org/advancedsearch.php?q=${encodeURIComponent(query)}+AND+mediatype:audio&fl[]=identifier,title,creator&rows=8&page=1&output=json`);
          const data = await res.json();
          const onlineTracks = (data.response.docs || []).map(doc => ({
            id: doc.identifier,
            title: doc.title || 'Unknown Title',
            artist: doc.creator || 'Traditional / Open Source',
            language: query.includes('tamil') ? 'TAMIL' : 'TELUGU',
            genre: 'ONLINE',
            streamUrl: `https://archive.org/download/${doc.identifier}/${doc.identifier}_vbr.mp3`,
            isDownloaded: false
          }));
          currentPlaylist = onlineTracks;
          renderTrackList(currentPlaylist);
        } catch (e) {
          container.innerHTML = `<div class="text-center text-rose-400 py-16 text-xs">Failed to connect to online sources. Check internet.</div>`;
        }
      }
    }

    function filterCategory(cat) {
      selectedCategory = cat;
      document.querySelectorAll('.cat-pill').forEach(el => {
        el.className = 'cat-pill bg-slate-800 text-slate-300 border border-slate-700 px-3 py-1 rounded-full font-medium shrink-0';
      });
      event.target.className = 'cat-pill bg-sky-500/20 text-sky-400 border border-sky-500/40 px-3 py-1 rounded-full font-medium shrink-0';
      executeSearch(document.getElementById('searchInput').value);
    }

    // Auto-sync function to ingest newly indexed legitimate songs
    async function triggerAutoSync() {
      const syncIcon = document.getElementById('syncIcon');
      syncIcon.classList.add('animate-spin');
      setTimeout(async () => {
        syncIcon.classList.remove('animate-spin');
        alert('Sync complete: Library is up to date with legitimate sources.');
      }, 1500);
    }

    // Playlist Dialog Helpers
    function openPlaylistModal() { document.getElementById('playlistModal').classList.remove('hidden'); }
    function closePlaylistModal() { document.getElementById('playlistModal').classList.add('hidden'); }
    function createPlaylist() {
      const name = document.getElementById('newPlaylistName').value.trim();
      if (!name) return;
      alert(`Playlist "${name}" created.`);
      document.getElementById('newPlaylistName').value = '';
    }
  </script>
</body>
</html>
